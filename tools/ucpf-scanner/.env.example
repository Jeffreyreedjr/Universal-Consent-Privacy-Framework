# =============================================================================
# UCPF Privacy Scanner - environment example
# Copy to .env and set secrets. Never commit .env.
#
# WordPress Advanced Settings > Scanner API URL / API key must match HOST:PORT
# and UCPF_SCANNER_API_KEYS below.
# =============================================================================

# --- HTTP bind ---
UCPF_SCANNER_HOST=0.0.0.0
UCPF_SCANNER_PORT=3847

# Required for any non-loopback client (comma-separated keys).
# Legacy alias: UCPF_SCANNER_API_KEY (single key) also works.
UCPF_SCANNER_API_KEYS=change-me-long-random-key

# Allow unauthenticated requests ONLY from loopback (127.0.0.1 / ::1).
# UCPF_SCANNER_ALLOW_LOCAL=1

# Optional node metadata (returned in /v1/info - not a compliance claim).
UCPF_SCANNER_NODE_ID=local
UCPF_SCANNER_REGIONS=US
# UCPF_SCANNER_MOBILE=1

# =============================================================================
# Scan intensity <-> sessions x pages (work units)
#
# WP "Scan intensity" maps to Playwright profile:
#   quick      -> 2 sessions  (Fresh visitor, Reject all)
#   standard   -> 6 sessions  (Fresh, Reject, Accept, Revoke, GPC on, DNS)
#   deep       -> 10 sessions (core 3 + analytics/functional/revoke/returning/
#                 GPC on/off/DNS) + optional service-worker pass on homepage
#
# Approximate steps ~= (sessions x selected_pages) + extras
# Example: deep x 21 pages ~= 210+ steps (admin progress "Step N/212").
#
# Caps below bound how large a job can grow and how long Chromium may run.
# =============================================================================

# Hard cap on pages per job (WP may send fewer via selected URLs).
# Align with plugin MAX_BROWSER_URLS (80) or raise if you intentionally scan more.
UCPF_SCANNER_MAX_PAGES=80

# Parallel scan jobs on this node (each holds a Chromium). Keep low on small VPS.
UCPF_SCANNER_MAX_CONCURRENT=2

# Delay between pages inside a session (ms). Raises total step time; helps CF/WAF.
UCPF_SCANNER_PAGE_GAP_MS=1500

# Wait after navigation / consent click before capturing cookies and network (ms).
UCPF_SCANNER_SETTLE_MS=4000

# Per-navigation timeout (ms).
UCPF_SCANNER_NAV_TIMEOUT_MS=25000

# Preferred whole-job Chromium budget (ms). Divided by real session count; each session also gets a floor from page count x estimated page cost so selected URLs can finish.
# Code default is 1800000 (30m). For Deep x ~40+ pages prefer 3600000+ (60m+). Truncation logs: "stopped at page N/M (session time budget)".
UCPF_SCANNER_BROWSER_TIMEOUT_MS=1800000

# Max HTTP redirects when fetching pages.
UCPF_SCANNER_MAX_REDIRECTS=5

# Optional Playwright recipe JSON (extra clicks / flows).
# UCPF_SCANNER_RECIPE=./recipe.json

# Browser User-Agent override (discovery + scan contexts).
# UCPF_SCANNER_UA=Mozilla/5.0 (...)

# Headed Chromium for debugging (default is headless).
# UCPF_SCANNER_HEADED=1

# =============================================================================
# API rate limits (WordPress polls jobs ~every 4s - GET polls are exempt)
# =============================================================================
UCPF_SCANNER_RATE_WINDOW_MS=60000
UCPF_SCANNER_RATE_MAX=180

# Auto-delete completed job reports after this many ms (default 1h).
UCPF_SCANNER_REPORT_TTL_MS=3600000

# --- Agency fleet (300+ sites) ---
UCPF_SCANNER_MAX_QUEUE=200
UCPF_SCANNER_MAX_RUNNING_PER_KEY=1
UCPF_SCANNER_MAX_QUEUED_PER_KEY=2
# UCPF_SCANNER_ADMIN_KEYS=admin-key-here
# UCPF_SCANNER_DATA_DIR=./data

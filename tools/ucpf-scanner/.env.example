# UCPF Privacy Scanner — environment example
# Copy to .env and set secrets. Never commit .env.

UCPF_SCANNER_HOST=0.0.0.0
UCPF_SCANNER_PORT=3847

# Required for any non-loopback client (comma-separated).
UCPF_SCANNER_API_KEYS=change-me-long-random-key

# Allow unauthenticated requests ONLY from loopback (127.0.0.1 / ::1).
# UCPF_SCANNER_ALLOW_LOCAL=1

UCPF_SCANNER_MAX_PAGES=100
UCPF_SCANNER_MAX_CONCURRENT=2
UCPF_SCANNER_PAGE_GAP_MS=1500

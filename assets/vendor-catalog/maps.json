{
  "services": [
    {
      "key": "youtube",
      "name": "YouTube Embeds",
      "provider": "Google",
      "category": "functional",
      "treatment": "consent",
      "description": "Embedded YouTube videos.",
      "privacy_url": "https://policies.google.com/privacy",
      "script_patterns": ["youtube.com/iframe_api", "www.youtube.com/s", "youtube.com", "youtu.be", "i.ytimg.com", "yt3.ggpht.com", "jnn-pa.googleapis.com"],
      "cookie_patterns": ["VISITOR_INFO1_LIVE", "YSC", "PREF", "VISITOR_PRIVACY_METADATA", "__Secure-YNID", "__Secure-ROLLOUT_TOKEN", "__Secure-YEC"],
      "cookies": [
        {
          "name": "VISITOR_INFO1_LIVE",
          "pattern": "VISITOR_INFO1_LIVE",
          "purpose": "Estimates user bandwidth on YouTube pages.",
          "retention": "6 months",
          "category": "functional",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "YSC",
          "pattern": "YSC",
          "purpose": "Registers a unique ID for statistics of which YouTube videos the user has seen.",
          "retention": "Session",
          "category": "functional",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "VISITOR_PRIVACY_METADATA",
          "pattern": "VISITOR_PRIVACY_METADATA",
          "purpose": "YouTube visitor privacy metadata for embedded players.",
          "retention": "months",
          "category": "marketing",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "__Secure-YNID",
          "pattern": "__Secure-YNID",
          "purpose": "YouTube player preferences, secure login aids, and spam detection.",
          "retention": "months",
          "category": "preferences",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "__Secure-ROLLOUT_TOKEN",
          "pattern": "__Secure-ROLLOUT_TOKEN",
          "purpose": "Registers a unique ID for YouTube video view statistics / feature rollout.",
          "retention": "months",
          "category": "marketing",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "__Secure-YEC",
          "pattern": "__Secure-YEC",
          "purpose": "YouTube embed / experiment cookie set with embedded players.",
          "retention": "months",
          "category": "marketing",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        }
      ],
      "iframe_patterns": ["youtube.com/embed", "youtube-nocookie.com/embed"],
      "default_blocking": true
    },
    {
      "key": "vimeo",
      "name": "Vimeo Embeds",
      "provider": "Vimeo",
      "category": "functional",
      "treatment": "consent",
      "description": "Embedded Vimeo videos.",
      "privacy_url": "https://vimeo.com/privacy",
      "script_patterns": ["player.vimeo.com"],
      "cookie_patterns": ["vuid"],
      "cookies": [
        {
          "name": "vuid",
          "pattern": "vuid",
          "purpose": "Collects data about Vimeo video visits.",
          "retention": "2 years",
          "category": "functional",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        }
      ],
      "iframe_patterns": ["player.vimeo.com"],
      "default_blocking": true
    },
    {
      "key": "google_maps",
      "name": "Google Maps",
      "provider": "Google",
      "category": "functional",

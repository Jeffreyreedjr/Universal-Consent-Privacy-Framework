{
  "services": [
    {
      "key": "wordpress_core",
      "name": "WordPress Core",
      "provider": "WordPress",
      "category": "necessary",
      "treatment": "necessary",
      "description": "Essential cookies for login, security, comments, and site functionality.",
      "privacy_url": "https://wordpress.org/about/privacy/",
      "script_patterns": [],
      "cookie_patterns": [
        "wordpress_*",
        "wordpress_logged_in_*",
        "wordpress_sec_*",
        "wordpress_test_cookie",
        "wp-settings-*",
        "wp-settings-time-*",
        "comment_author_*"
      ],
      "cookies": [
        {
          "name": "wordpress_logged_in_*",
          "pattern": "wordpress_logged_in_*",
          "purpose": "Keeps a logged-in user authenticated across pages.",
          "retention": "Session / 14 days (Remember Me)",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["logged_in"]
        },
        {
          "name": "wordpress_sec_*",
          "pattern": "wordpress_sec_*",
          "purpose": "Protects logged-in sessions against unauthorized access.",
          "retention": "Session / 14 days",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["logged_in"]
        },
        {
          "name": "wordpress_test_cookie",
          "pattern": "wordpress_test_cookie",
          "purpose": "Checks whether the browser accepts cookies.",
          "retention": "Session",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "wp-settings-*",
          "pattern": "wp-settings-*",
          "purpose": "Stores logged-in user interface preferences in wp-admin.",
          "retention": "1 year",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["logged_in"]
        },
        {
          "name": "wp-settings-time-*",
          "pattern": "wp-settings-time-*",
          "purpose": "Stores timing of wp-admin UI preference updates.",
          "retention": "1 year",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["logged_in"]
        },
        {
          "name": "comment_author_*",
          "pattern": "comment_author_*",
          "purpose": "Remembers commenter name, email, and URL for future comments.",
          "retention": "1 year",
          "category": "preferences",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        }
      ],
      "iframe_patterns": [],
      "default_blocking": false
    },
    {

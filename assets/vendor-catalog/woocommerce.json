{
  "services": [
    {
      "key": "woocommerce",
      "name": "WooCommerce",
      "provider": "Automattic",
      "category": "necessary",
      "treatment": "necessary",
      "description": "Cart, session, and checkout cookies required for e-commerce functionality.",
      "privacy_url": "https://automattic.com/privacy/",
      "script_patterns": [
        "/woocommerce/assets",
        "woocommerce.min.js",
        "wc-add-to-cart",
        "wc-cart-fragments",
        "wc-checkout"
      ],
      "cookie_patterns": [
        "woocommerce_cart_hash",
        "woocommerce_items_in_cart",
        "wp_woocommerce_session_*",
        "woocommerce_recently_viewed",
        "store_notice*"
      ],
      "cookies": [
        {
          "name": "woocommerce_cart_hash",
          "pattern": "woocommerce_cart_hash",
          "purpose": "Helps WooCommerce determine when cart contents change.",
          "retention": "Session",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["guest", "logged_in", "checkout"]
        },
        {
          "name": "woocommerce_items_in_cart",
          "pattern": "woocommerce_items_in_cart",
          "purpose": "Records whether the cart contains items.",
          "retention": "Session",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["guest", "logged_in", "checkout"]
        },
        {
          "name": "wp_woocommerce_session_*",
          "pattern": "wp_woocommerce_session_*",
          "purpose": "Contains a unique code for each customer so cart data can be retrieved.",
          "retention": "2 days",
          "category": "necessary",
          "treatment": "necessary",
          "contexts": ["guest", "logged_in", "checkout"]
        },
        {
          "name": "woocommerce_recently_viewed",
          "pattern": "woocommerce_recently_viewed",
          "purpose": "Stores recently viewed products for recommendations.",
          "retention": "Session",
          "category": "preferences",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "store_notice*",
          "pattern": "store_notice*",
          "purpose": "Allows visitors to dismiss store notices.",
          "retention": "Session",
          "category": "preferences",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        }
      ],
      "iframe_patterns": [],
      "default_blocking": false
    },
    {
      "key": "woocommerce_order_attribution",
      "name": "WooCommerce Order Attribution",
      "provider": "Automattic",
      "category": "analytics",
      "treatment": "consent",
      "description": "Sourcebuster / order-attribution scripts (sbjs_* cookies). Separate from necessary cart/checkout cookies.",
      "privacy_url": "https://automattic.com/privacy/",
      "script_patterns": [
        "sourcebuster.min.js",
        "sourcebuster",
        "order-attribution.min.js",
        "wc-order-attribution"
      ],
      "cookie_patterns": [
        "sbjs_migrations",
        "sbjs_current_add",
        "sbjs_first_add",
        "sbjs_current",
        "sbjs_first",
        "sbjs_udata",
        "sbjs_session",
        "sbjs_*"
      ],
      "cookies": [
        {
          "name": "sbjs_session",
          "pattern": "sbjs_session",
          "purpose": "Page views in this session and current path for order attribution.",
          "retention": "Session",
          "category": "analytics",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "sbjs_udata",
          "pattern": "sbjs_udata",
          "purpose": "Visitor user-agent related attribution data.",
          "retention": "months",
          "category": "analytics",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "sbjs_current",
          "pattern": "sbjs_current",
          "purpose": "Traffic origin for the current visit.",
          "retention": "months",
          "category": "analytics",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        },
        {
          "name": "sbjs_first",
          "pattern": "sbjs_first",
          "purpose": "Traffic origin for the first visit in attribution window.",
          "retention": "months",
          "category": "analytics",
          "treatment": "consent",
          "contexts": ["guest", "logged_in"]
        }
      ],
      "iframe_patterns": [],
      "default_blocking": true
    },
    {
      "key": "woo_discount_rules",
      "name": "Woo Discount Rules",
      "provider": "Flycart",
      "category": "necessary",
      "treatment": "necessary",
      "description": "First-party storefront discount / dynamic price UI scripts (not a marketing tracker).",
      "privacy_url": "",
      "script_patterns": [
        "/woo-discount-rules/",
        "awdr-dynamic-price"
      ],
      "cookie_patterns": [],
      "cookies": [],
      "iframe_patterns": [],
      "default_blocking": false
    }
  ]
}
